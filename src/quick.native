<!--
  Quick Focus · Cobalt Instrument

  A compact control surface with one deliberate path:
  choose the work, set the block, start the timer.
  It shares the exact model, commands, and SQLite authority with the ledger.
-->
<stack role="group" label="Quick Focus">
  <column background="background" grow="1" padding="14" gap="10" label="Quick Focus controller">
    <row gap="10" cross="center">
      <column gap="1" grow="1">
        <text><span weight="bold">Quick Focus</span></text>
        <text size="sm" foreground="text_muted">{todayGoalText}</text>
      </column>
      <stack>
        <button
          size="icon"
          variant="ghost"
          icon="external-link"
          label="Open full Focus Tracker"
          on-press="open_full_app"
        ></button>
        <tooltip anchor="below">Open Focus Tracker</tooltip>
      </stack>
    </row>

    <separator />

    <if test="{loadState == 'loading'}">
      <column grow="1" gap="12" main="center" label="Loading Quick Focus">
        <row gap="8" cross="center">
          <spinner />
          <text foreground="text_muted">Opening your local ledger</text>
        </row>
        <skeleton width="280" height="20" />
        <skeleton width="364" height="42" />
        <skeleton width="364" height="88" />
      </column>
    </if>

    <else>
      <if test="{loadState == 'fatal'}">
        <column grow="1" gap="12" main="center" label="Quick Focus could not load">
          <text size="heading"><span weight="bold">Couldn’t open the ledger.</span></text>
          <text wrap="true" foreground="text_muted">{fatalErrorText}</text>
          <row gap="8">
            <button variant="primary" icon="refresh-cw" on-press="retry_boot">Try again</button>
            <button variant="ghost" on-press="quit_app">Quit</button>
          </row>
        </column>
      </if>

      <else>
        <if test="{sessionState == 'idle'}">
          <column grow="1" gap="10" label="Prepare a focus block">
            <scroll grow="1" overscroll="rubber_band">
              <column gap="8">
                <if test="{breakAcknowledgementOpen}">
                  <row background="surface_subtle" radius="lg" padding="10" gap="8" cross="center" label="Break recorded">
                    <column gap="1" grow="1">
                      <text><span weight="medium">Break recorded</span></text>
                      <text size="sm" wrap="true" foreground="text_muted">{breakCompletionSummary} Task stays open.</text>
                    </column>
                    <button
                      size="icon"
                      variant="ghost"
                      icon="x"
                      label="Dismiss break record"
                      on-press="dismiss_break_acknowledgement"
                    ></button>
                  </row>
                </if>

                <row gap="8" cross="center" label="Choose or add a task">
                  <column gap="1" grow="1">
                    <text><span weight="medium">Choose or add a task</span></text>
                    <text size="sm" foreground="text_muted">{quickTaskCountText}</text>
                  </column>
                </row>

                <row gap="8" cross="center">
                  <text-field
                    key="{composerKey}"
                    grow="1"
                    text="{taskDraft}"
                    placeholder="Add a concrete next action"
                    label="New task for Quick Focus"
                    autofocus="{quickComposerAutofocus}"
                    on-input="task_draft_edit"
                    on-submit="add_task"
                  />
                  <stack>
                    <button
                      size="icon"
                      variant="secondary"
                      icon="plus"
                      label="Add and select task"
                      disabled="{not canAddTask or quickControlsDisabled}"
                      on-press="add_task"
                    ></button>
                    <tooltip anchor="above">Add and select task</tooltip>
                  </stack>
                </row>

                <if test="{quickHasTasks}">
                  <list gap="2" label="Choose an open task for Quick Focus">
                    <for each="quickTasks" key="id" as="q">
                      <list-item
                        global-key="{q.id}"
                        selected="{q.selected}"
                        disabled="{quickControlsDisabled}"
                        label="{q.accessibilityLabel}"
                        on-press="select_quick_task:{q.id}"
                      >
                        <text grow="1" overflow="ellipsis">{q.title}</text>
                      </list-item>
                    </for>
                  </list>
                  <if test="{quickHasMoreTasks}">
                    <button size="sm" variant="ghost" icon="external-link" on-press="open_full_app">Show all open tasks</button>
                  </if>
                </if>

                <else>
                  <column background="surface_subtle" radius="lg" padding="10" gap="3" label="No open tasks">
                    <text><span weight="medium">Add the next concrete action.</span></text>
                    <text size="sm" wrap="true" foreground="text_muted">It will be selected automatically.</text>
                  </column>
                </else>
              </column>
            </scroll>

            <column gap="8" label="Choose duration, then start">
              <row gap="8" cross="center">
                <text grow="1"><span weight="medium">Duration</span></text>
                <toggle-group label="Focus length in minutes" gap="2">
                  <toggle-button size="sm" selected="{focusLengthMinutes == 25}" disabled="{quickControlsDisabled}" on-toggle="set_duration_25">25 min</toggle-button>
                  <toggle-button size="sm" selected="{focusLengthMinutes == 50}" disabled="{quickControlsDisabled}" on-toggle="set_duration_50">50 min</toggle-button>
                  <toggle-button size="sm" selected="{focusLengthMinutes == 90}" disabled="{quickControlsDisabled}" on-toggle="set_duration_90">90 min</toggle-button>
                </toggle-group>
              </row>
              <button key="{quickStartFocusKey}" grow="1" variant="primary" icon="play" autofocus="{startAutofocus}" disabled="{not quickCanStart}" on-press="start_focus">{quickStartLabel}</button>
            </column>
          </column>
        </if>

        <else>
          <scroll grow="1" overscroll="rubber_band">
            <column gap="10">
              <if test="{sessionState == 'running'}">
                <column background="surface_subtle" radius="xl" padding="14" gap="10" main="center" cross="center" label="Active focus transport">
                  <column width="332" gap="1">
                    <if test="{isBreak}">
                      <text size="sm" foreground="text_muted"><span weight="medium">Recovery block</span></text>
                    </if>
                    <else>
                      <text size="sm" foreground="text_muted"><span weight="medium">Focus block</span></text>
                    </else>
                    <text overflow="ellipsis">{quickTaskTitle}</text>
                  </column>
                  <text size="display" text-alignment="center" label="{timerA11y}"><span mono="true" weight="medium" scale="1.35">{pad(remainingMinutes, 2)}:{pad(remainingSeconds, 2)}</span></text>
                  <if test="{isBreak}">
                    <progress width="332" value="{focusProgress}" label="Break progress" />
                  </if>
                  <else>
                    <progress width="332" value="{focusProgress}" label="Focus block progress" />
                  </else>
                  <row width="332" gap="8" label="Timer transport controls">
                    <button key="running-primary" grow="1" variant="secondary" icon="pause" autofocus="{transportAutofocus and not endDialogOpen}" disabled="{quickControlsDisabled}" on-press="pause_focus">Pause</button>
                    <button grow="1" variant="ghost" disabled="{saving or hasWriteError}" on-press="request_quick_end_focus">Finish…</button>
                  </row>
                </column>
              </if>

              <if test="{sessionState == 'paused'}">
                <column background="surface_subtle" radius="xl" padding="14" gap="10" main="center" cross="center" label="Paused focus transport">
                  <column width="332" gap="1">
                    <text size="sm" foreground="text_muted"><span weight="medium">Paused</span></text>
                    <text overflow="ellipsis">{quickTaskTitle}</text>
                  </column>
                  <text size="display" text-alignment="center" label="{timerA11y}"><span mono="true" weight="medium" scale="1.35">{pad(remainingMinutes, 2)}:{pad(remainingSeconds, 2)}</span></text>
                  <if test="{isBreak}">
                    <progress width="332" value="{focusProgress}" label="Paused break progress" />
                  </if>
                  <else>
                    <progress width="332" value="{focusProgress}" label="Paused focus block progress" />
                  </else>
                  <row width="332" gap="8" label="Paused timer transport controls">
                    <button key="paused-primary" grow="1" variant="primary" icon="play" autofocus="{transportAutofocus and not endDialogOpen}" disabled="{quickControlsDisabled}" on-press="resume_focus">Resume</button>
                    <button grow="1" variant="ghost" disabled="{saving or hasWriteError}" on-press="request_quick_end_focus">Finish…</button>
                  </row>
                </column>
              </if>

              <if test="{sessionState == 'complete' and quickCompletionDialogOpen}">
                <column background="surface_subtle" radius="xl" padding="14" gap="8" main="center" cross="center" label="Recorded focus block and optional task choices">
                  <column width="332" gap="1">
                    <text><span weight="bold">Focus recorded</span></text>
                    <text size="sm" foreground="text_muted">{quickCompletionSummary}</text>
                  </column>
                  <text width="332" overflow="ellipsis" text-alignment="center">{quickTaskTitle}</text>
                  <text width="332" wrap="true" text-alignment="center" size="sm" foreground="text_muted">The task is still open. You can reverse a completed task later.</text>
                  <column width="332" gap="6">
                    <button variant="primary" icon="check" disabled="{saving or hasWriteError}" on-press="complete_task_after_focus">Mark task complete</button>
                    <button key="complete-safe" variant="secondary" autofocus="true" disabled="{saving or hasWriteError}" on-press="keep_task_open_after_focus">Keep task open</button>
                    <button variant="ghost" icon="clock" disabled="{saving or hasWriteError}" on-press="start_break">Keep task open + start {nextBreakMinutes} min break</button>
                  </column>
                </column>
              </if>

              <if test="{sessionState == 'complete' and not quickCompletionDialogOpen}">
                <column background="surface_subtle" radius="xl" padding="14" gap="10" main="center" cross="center" label="Completed focus block">
                  <text size="heading"><span weight="bold">Focus recorded.</span></text>
                  <text wrap="true" text-alignment="center" foreground="text_muted">The task is still open in Focus Tracker.</text>
                  <button variant="primary" on-press="open_full_app">Update task</button>
                </column>
              </if>
            </column>
          </scroll>
        </else>

        <if test="{saving or hasWriteError}">
          <separator />
          <if test="{saving}">
            <row height="32" gap="8" cross="center" label="Saving changes">
              <spinner />
              <text size="sm" foreground="text_muted">Saving</text>
            </row>
          </if>
          <else>
            <row height="32" gap="8" cross="center" label="Changes were not saved">
              <text size="sm" foreground="destructive"><span weight="medium">Unable to save</span></text>
              <text grow="1" size="sm" foreground="text_muted" overflow="ellipsis">{writeErrorText}</text>
              <button size="sm" variant="ghost" on-press="discard_failed_change">Discard</button>
              <button size="sm" variant="ghost" icon="refresh-cw" on-press="retry_save">Retry</button>
            </row>
          </else>
        </if>
      </else>
    </else>
  </column>

  <if test="{quickEndDialogOpen and not isBreak}">
    <column main="center" cross="center">
      <dialog text="Finish this focus block?" width="352" padding="18" on-dismiss="cancel_end_focus">
        <column gap="10">
          <spacer height="28" />
          <text wrap="true" foreground="text_muted">Keep the focused time so far, or discard this unfinished block.</text>
          <button variant="ghost" autofocus="true" on-press="cancel_end_focus">Continue focusing</button>
          <button variant="destructive" disabled="{saving or hasWriteError}" on-press="confirm_end_focus">Discard block</button>
          <button variant="primary" icon="check" disabled="{saving or hasWriteError}" on-press="finish_focus_now">Record elapsed time</button>
          <spacer height="8" />
        </column>
      </dialog>
    </column>
  </if>

  <if test="{quickEndDialogOpen and isBreak}">
    <column main="center" cross="center">
      <dialog text="Finish this break?" width="352" padding="18" on-dismiss="cancel_end_focus">
        <column gap="10">
          <spacer height="28" />
          <text wrap="true" foreground="text_muted">Keep the rest taken so far, or discard this unfinished break.</text>
          <button variant="ghost" autofocus="true" on-press="cancel_end_focus">Continue break</button>
          <button variant="destructive" disabled="{saving or hasWriteError}" on-press="confirm_end_focus">Discard break</button>
          <button variant="primary" icon="check" disabled="{saving or hasWriteError}" on-press="finish_focus_now">Record break so far</button>
          <spacer height="8" />
        </column>
      </dialog>
    </column>
  </if>
</stack>
