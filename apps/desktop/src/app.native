<!--
  Focus Tracker — Cobalt Instrument

  Two surfaces, one job. The rail keeps the day's work capturable at every
  moment, including mid-block. The chamber is a real instrument: it states
  what is about to happen, how long it will take, and what today already
  looks like, instead of leaving the workspace empty until a timer runs.
-->
<stack>
  <column background="background" grow="1">
    <!-- Native titlebar: identity, workspace switcher, one utility action. -->
    <row window-drag="true" height="{headerHeight}" padding="8" gap="8" cross="center">
      <spacer width="{chromeLeading}" />
      <text><span weight="bold">Focus Tracker</span></text>

      <tabs label="Workspace sections" gap="2">
        <button
          size="sm"
          selected="{section == 'today'}"
          on-press="show_today"
        >Today</button>
        <button
          size="sm"
          selected="{section == 'ledger'}"
          on-press="show_ledger"
        >Ledger</button>
      </tabs>

      <spacer grow="1" />

      <row width="112" main="end" cross="center">
        <if test="{saving}">
          <row gap="8" cross="center" label="Saving changes">
            <spinner />
            <text foreground="text_muted">Saving</text>
          </row>
        </if>
      </row>

      <stack>
        <button
          size="icon"
          variant="ghost"
          icon="clock"
          label="Open Quick Focus"
          on-press="open_quick"
        ></button>
        <tooltip anchor="below">Quick Focus</tooltip>
      </stack>
    </row>

    <separator />

    <!-- Boot keeps the final composition visible while SQLite opens. -->
    <if test="{loadState == 'loading'}">
      <row grow="1" label="Loading Focus Tracker local data">
        <column width="380" background="surface_subtle" padding="20" gap="16">
          <skeleton width="160" height="26" />
          <skeleton width="340" height="32" />
          <skeleton width="228" height="32" />
          <column gap="8">
            <skeleton width="340" height="52" />
            <skeleton width="340" height="52" />
            <skeleton width="340" height="52" />
          </column>
        </column>
        <separator />
        <column grow="1" padding="32" gap="20" main="center" cross="center">
          <skeleton width="120" height="20" />
          <skeleton width="420" height="180" />
          <row gap="8" cross="center" label="Opening local focus ledger">
            <spinner />
            <text foreground="text_muted">Opening your local ledger</text>
          </row>
        </column>
      </row>
    </if>

    <else>
      <if test="{loadState == 'fatal'}">
        <row grow="1" main="center" cross="center" padding="32">
          <alert text="Focus Tracker could not open" width="520">
            <column gap="16">
              <text wrap="true" foreground="text_muted">{fatalErrorText}</text>
              <row gap="8">
                <button variant="primary" icon="refresh-cw" on-press="retry_boot">Try again</button>
                <button variant="ghost" on-press="quit_app">Quit</button>
              </row>
            </column>
          </alert>
        </row>
      </if>

      <else>
        <if test="{hasWriteError}">
          <alert text="The latest change was not saved">
            <column gap="8">
              <text wrap="true" foreground="text_muted">{writeErrorText}</text>
              <row gap="8">
                <button size="sm" variant="outline" icon="refresh-cw" on-press="retry_save">Retry save</button>
                <button size="sm" variant="ghost" on-press="discard_failed_change">Discard change</button>
              </row>
            </column>
          </alert>
        </if>

        <if test="{section == 'today'}">
          <split
            grow="1"
            gap="1"
            value="{paneFraction}"
            on-resize="pane_resized"
            resize-duration="260"
            resize-easing="spring"
          >
            <!--
              Task rail. It contracts when a block starts but never stops
              accepting work: an interruption that arrives mid-block belongs
              in the ledger, not in the user's head.
            -->
            <column min-width="304" background="surface_subtle" padding="16" gap="12">
              <row gap="8" cross="center">
                <text grow="1"><span weight="bold">Today</span></text>
                <if test="{focusing}">
                  <badge variant="secondary" icon="clock">{pad(remainingMinutes, 2)}:{pad(remainingSeconds, 2)}</badge>
                </if>
                <else>
                  <text size="sm" foreground="text_muted">{filterCountText}</text>
                </else>
              </row>

              <row gap="8" cross="center">
                <text-field
                  key="{composerKey}"
                  grow="1"
                  text="{taskDraft}"
                  placeholder="Add the next concrete action"
                  label="New task"
                  autofocus="{mainComposerAutofocus}"
                  on-input="task_draft_edit"
                  on-submit="add_task"
                />
                <stack>
                  <button
                    size="icon"
                    variant="ghost"
                    icon="plus"
                    label="Add task"
                    disabled="{not canAddTask}"
                    on-press="add_task"
                  ></button>
                  <tooltip anchor="above">Add task</tooltip>
                </stack>
              </row>

              <row gap="8" cross="center">
                <tabs label="Task filter" gap="2">
                  <button size="sm" selected="{taskFilter == 'open'}" autofocus="{focusRecoveryKind == 'task_filter' and taskFilter == 'open'}" on-press="show_open_tasks">Open</button>
                  <button size="sm" selected="{taskFilter == 'completed'}" autofocus="{focusRecoveryKind == 'task_filter' and taskFilter == 'completed'}" on-press="show_completed_tasks">Completed</button>
                  <button size="sm" selected="{taskFilter == 'archived'}" autofocus="{focusRecoveryKind == 'task_filter' and taskFilter == 'archived'}" on-press="show_archived_tasks">Archived</button>
                </tabs>
                <spacer grow="1" />
                <if test="{focusing}">
                  <text size="sm" foreground="text_muted">{filterCountText}</text>
                </if>
              </row>

              <scroll grow="1" overscroll="rubber_band">
                <list gap="4" label="{taskListLabel}">
                  <for each="visibleTasks" key="id" as="t">
                    <list-item
                      global-key="{t.id}"
                      selected="{t.id == actionTaskId}"
                      autofocus="{t.autofocus}"
                      on-press="select_task:{t.id}"
                      label="{t.title}"
                    >
                      <!--
                        Leading gutter. Trailing controls are icon buttons and
                        badges that carry their own optical inset, so the row
                        needs this to sit symmetrically inside the selection wash.
                      -->
                      <spacer width="8" />
                      <if test="{t.archived}">
                        <icon name="archive" foreground="text_muted" />
                      </if>
                      <else>
                        <checkbox
                          checked="{t.done}"
                          disabled="{saving or hasWriteError or t.id == activeFocusTaskId}"
                          label="{t.toggleLabel}"
                          on-toggle="toggle_task:{t.id}"
                        />
                      </else>
                      <spacer width="8" />

                      <if test="{t.id == editTaskId}">
                        <text-field
                          key="{editFocusKey}"
                          grow="1"
                          text="{editDraft}"
                          placeholder="Task title"
                          label="{t.renameLabel}"
                          autofocus="{editAutofocus}"
                          on-input="edit_draft_edit"
                          on-submit="commit_rename"
                        />
                        <button
                          icon="x"
                          size="icon"
                          variant="ghost"
                          label="{t.cancelRenameLabel}"
                          on-press="cancel_rename"
                        ></button>
                        <button
                          icon="check"
                          size="icon"
                          variant="secondary"
                          disabled="{not canCommitRename}"
                          label="{t.saveRenameLabel}"
                          on-press="commit_rename"
                        ></button>
                      </if>

                      <else>
                        <if test="{t.done}">
                          <text grow="1" foreground="text_muted" overflow="ellipsis">{t.title}</text>
                        </if>
                        <else>
                          <text grow="1" overflow="ellipsis">{t.title}</text>
                        </else>

                        <!-- The block running right now names its own row. -->
                        <if test="{t.id == activeFocusTaskId}">
                          <badge variant="secondary">Focusing</badge>
                        </if>

                        <!-- The leading archive icon already states the state. -->
                        <if test="{t.archived and t.id == actionTaskId and not focusing}">
                          <button
                            variant="ghost"
                            icon="refresh-cw"
                            disabled="{saving or hasWriteError}"
                            label="{t.restoreLabel}"
                            on-press="restore_task:{t.id}"
                          >Restore</button>
                          <button
                            size="icon"
                            variant="ghost"
                            icon="trash"
                            autofocus="{t.purgeAutofocus}"
                            disabled="{saving or hasWriteError}"
                            label="{t.purgeLabel}"
                            on-press="request_purge_task:{t.id}"
                          ></button>
                        </if>

                        <if test="{not t.archived and t.id == actionTaskId and t.id != activeFocusTaskId}">
                          <stack>
                            <button
                              size="icon"
                              variant="ghost"
                              icon="ellipsis"
                              selected="{taskActionsTaskId == t.id}"
                              disabled="{saving or hasWriteError}"
                              label="More task actions"
                              on-press="toggle_task_actions:{t.id}"
                            ></button>
                            <if test="{taskActionsTaskId == t.id}">
                              <dropdown-menu
                                width="184"
                                anchor="below"
                                anchor-alignment="end"
                                label="Task actions"
                                on-dismiss="dismiss_task_actions"
                              >
                                <if test="{t.done}">
                                  <menu-item on-press="toggle_task:{t.id}">Reopen task</menu-item>
                                </if>
                                <else>
                                  <menu-item disabled="{focusing}" on-press="start_focus_task:{t.id}">Focus this task</menu-item>
                                </else>
                                <menu-item on-press="begin_rename:{t.id}">Rename</menu-item>
                                <separator />
                                <menu-item on-press="delete_task:{t.id}">Archive</menu-item>
                              </dropdown-menu>
                            </if>
                          </stack>
                        </if>
                      </else>

                      <context-menu>
                        <if test="{t.archived}">
                          <menu-item disabled="{saving or hasWriteError or focusing}" on-press="restore_task:{t.id}">{t.restoreLabel}</menu-item>
                          <separator />
                          <menu-item disabled="{saving or hasWriteError or focusing}" on-press="request_purge_task:{t.id}">{t.purgeLabel}</menu-item>
                        </if>
                        <else>
                          <if test="{t.done}">
                            <menu-item disabled="{saving or hasWriteError}" on-press="toggle_task:{t.id}">{t.toggleLabel}</menu-item>
                          </if>
                          <else>
                            <menu-item disabled="{saving or hasWriteError or focusing}" on-press="start_focus_task:{t.id}">{t.focusLabel}</menu-item>
                          </else>
                          <menu-item disabled="{saving or hasWriteError}" on-press="begin_rename:{t.id}">{t.renameLabel}</menu-item>
                          <separator />
                          <menu-item disabled="{saving or hasWriteError or t.id == activeFocusTaskId}" on-press="delete_task:{t.id}">{t.archiveLabel}</menu-item>
                        </else>
                      </context-menu>
                    </list-item>
                  </for>

                  <else>
                    <column padding="24" gap="8" main="center" cross="center">
                      <if test="{taskFilter == 'open'}">
                        <text text-alignment="center"><span weight="bold">No open tasks</span></text>
                        <text width="230" wrap="true" text-alignment="center" foreground="text_muted">Add a task to prepare your next focus block.</text>
                      </if>
                      <if test="{taskFilter == 'completed'}">
                        <text text-alignment="center"><span weight="bold">Nothing completed yet</span></text>
                        <text width="230" wrap="true" text-alignment="center" foreground="text_muted">Finished work stays here without crowding the day.</text>
                      </if>
                      <if test="{taskFilter == 'archived'}">
                        <text text-alignment="center"><span weight="bold">The archive is empty</span></text>
                        <text width="230" wrap="true" text-alignment="center" foreground="text_muted">Archived tasks remain recoverable.</text>
                      </if>
                    </column>
                  </else>
                </list>
              </scroll>

              <if test="{hasUndo}">
                <row background="surface" radius="lg" padding="12" gap="8" cross="center">
                  <text grow="1" overflow="ellipsis">{undoText}</text>
                  <button size="sm" variant="ghost" disabled="{saving or hasWriteError}" on-press="undo_delete">Undo</button>
                  <button icon="x" size="icon" variant="ghost" label="Dismiss undo" on-press="dismiss_undo"></button>
                </row>
              </if>
            </column>

            <!--
              The focus chamber. The workspace switcher in the titlebar already
              names this section, so the pane spends its height on the
              instrument instead of repeating a heading above it.
            -->
            <column min-width="540" grow="1" background="background">
              <!-- The instrument itself, optically centred in the pane. -->
              <column grow="1" padding="24" main="center" cross="center">
                <if test="{sessionState == 'idle'}">
                  <column width="560" gap="20" cross="center">
                    <if test="{breakAcknowledgementOpen}">
                      <row width="560" background="surface_subtle" radius="lg" padding="12" gap="12" cross="center" label="Break recorded">
                        <icon name="check-circle" foreground="success" />
                        <column gap="2" grow="1">
                          <text><span weight="medium">Break recorded</span></text>
                          <text size="sm" wrap="true" foreground="text_muted">{breakCompletionSummary} Your task is still open.</text>
                        </column>
                        <button
                          size="icon"
                          variant="ghost"
                          icon="x"
                          label="Dismiss break record"
                          on-press="dismiss_break_acknowledgement"
                        ></button>
                      </row>
                    </if>

                    <if test="{selectedTaskExists}">
                      <column width="560" gap="20" cross="center" label="Focus block ready to start">
                        <column gap="6" cross="center">
                          <text size="sm" foreground="text_muted"><span weight="medium">{blockRankText}</span></text>
                          <text width="560" text-alignment="center" size="heading" overflow="ellipsis">{focusTaskTitle}</text>
                        </column>

                        <text size="display" text-alignment="center" label="{selectedFocusIntervalLabel}">
                          <span mono="true" weight="medium" scale="1.5">{pad(focusLengthMinutes, 2)}:00</span>
                        </text>

                        <!--
                          This block's length, not the saved default. It commits
                          nothing, so it can be dialled to any length SQLite
                          accepts instead of the three the presets name.
                        -->
                        <row gap="8" cross="center" label="Length of this focus block">
                          <button
                            size="sm"
                            variant="outline"
                            label="Shorten this block by 5 minutes"
                            disabled="{not canShortenFocus}"
                            on-press="shorten_focus"
                          >-5</button>
                          <toggle-group label="Focus length presets" gap="2">
                            <toggle-button size="sm" selected="{focusLengthMinutes == 25}" on-toggle="use_duration_25">25 min</toggle-button>
                            <toggle-button size="sm" selected="{focusLengthMinutes == 50}" on-toggle="use_duration_50">50 min</toggle-button>
                            <toggle-button size="sm" selected="{focusLengthMinutes == 90}" on-toggle="use_duration_90">90 min</toggle-button>
                          </toggle-group>
                          <button
                            size="sm"
                            variant="outline"
                            label="Lengthen this block by 5 minutes"
                            disabled="{not canLengthenFocus}"
                            on-press="lengthen_focus"
                          >+5</button>
                        </row>

                        <column gap="8" cross="center">
                          <button
                            key="{mainStartFocusKey}"
                            variant="primary"
                            icon="play"
                            autofocus="{startAutofocus and not purgeDialogOpen}"
                            disabled="{saving or hasWriteError}"
                            on-press="start_focus"
                          >Start {focusLengthMinutes} min focus</button>
                          <text size="sm" text-alignment="center" foreground="text_muted">Cmd+Shift+Space · {nextBreakText} afterwards</text>
                        </column>
                      </column>
                    </if>

                    <else>
                      <column width="440" gap="12" cross="center" label="Choose a focus task">
                        <icon name="circle-dot" foreground="text_muted" />
                        <if test="{taskFilter == 'open'}">
                          <if test="{hasAnyTask}">
                            <text size="heading" text-alignment="center"><span weight="bold">Pick something to focus on</span></text>
                            <text width="420" wrap="true" text-alignment="center" foreground="text_muted">Select an open task in the rail, or write the next concrete action and press Return.</text>
                          </if>
                          <else>
                            <text size="heading" text-alignment="center"><span weight="bold">Start with one concrete action</span></text>
                            <text width="420" wrap="true" text-alignment="center" foreground="text_muted">Name the next thing you will actually do. Focus Tracker keeps it, times it, and records the result locally.</text>
                            <row>
                              <button variant="primary" icon="plus" on-press="new_task_command">Add your first task</button>
                            </row>
                          </else>
                        </if>
                        <else>
                          <text size="heading" text-alignment="center"><span weight="bold">Nothing here can be focused</span></text>
                          <text width="420" wrap="true" text-alignment="center" foreground="text_muted">Return to open tasks to choose your next block.</text>
                          <row>
                            <button variant="primary" on-press="show_open_tasks">Show open tasks</button>
                          </row>
                        </else>
                      </column>
                    </else>
                  </column>
                </if>

                <if test="{sessionState == 'running' or sessionState == 'paused'}">
                  <column width="560" gap="24" cross="center">
                    <column gap="6" cross="center">
                      <if test="{sessionState == 'paused'}">
                        <if test="{isBreak}">
                          <badge icon="pause">Break paused</badge>
                        </if>
                        <else>
                          <badge icon="pause">Focus paused</badge>
                        </else>
                      </if>
                      <else>
                        <if test="{isBreak}">
                          <badge variant="secondary" icon="clock">Break in progress</badge>
                        </if>
                        <else>
                          <badge variant="secondary" icon="clock">Focus in progress</badge>
                        </else>
                      </else>
                      <text width="560" text-alignment="center"><span weight="medium">{focusTaskTitle}</span></text>
                    </column>

                    <text size="display" text-alignment="center" label="{timerA11y}">
                      <span mono="true" weight="medium" scale="1.9">{pad(remainingMinutes, 2)}:{pad(remainingSeconds, 2)}</span>
                    </text>

                    <column width="440" gap="6">
                      <if test="{isBreak}">
                        <progress width="440" height="6" value="{focusProgress}" label="Break progress" />
                      </if>
                      <else>
                        <progress width="440" height="6" value="{focusProgress}" label="Focus block progress" />
                      </else>
                      <row>
                        <text size="sm" grow="1" foreground="text_muted">{sessionElapsedText}</text>
                        <text size="sm" foreground="text_muted">{percent(focusProgress)}</text>
                      </row>
                    </column>

                    <row gap="8">
                      <if test="{sessionState == 'paused'}">
                        <button key="paused-primary" variant="primary" icon="play" autofocus="{transportAutofocus and not endDialogOpen}" disabled="{saving or hasWriteError}" on-press="resume_focus">Resume</button>
                      </if>
                      <else>
                        <button key="running-primary" variant="primary" icon="pause" autofocus="{transportAutofocus and not endDialogOpen}" disabled="{saving or hasWriteError}" on-press="pause_focus">Pause</button>
                      </else>
                      <if test="{isBreak}">
                        <button variant="outline" disabled="{saving or hasWriteError}" on-press="request_end_focus">End break</button>
                      </if>
                      <else>
                        <button variant="outline" disabled="{saving or hasWriteError}" on-press="request_end_focus">End block</button>
                      </else>
                    </row>
                  </column>
                </if>

                <if test="{sessionState == 'complete'}">
                  <column width="520" background="surface_subtle" radius="xl" padding="24" gap="20" cross="center" label="Recorded focus block and optional task choices">
                    <column gap="8" cross="center">
                      <icon name="check-circle" foreground="success" />
                      <text size="heading" text-alignment="center"><span weight="bold">Focus recorded</span></text>
                      <text width="440" wrap="true" text-alignment="center" foreground="text_muted">{completionSummary}</text>
                    </column>

                    <row width="440"><separator /></row>

                    <column width="440" gap="8" label="Task and break choices">
                      <text size="sm" text-alignment="center" foreground="text_muted">The task is still open. Completing it can be reversed from Completed.</text>
                      <row gap="8" main="center">
                        <button key="complete-safe" variant="secondary" autofocus="true" disabled="{saving or hasWriteError}" on-press="keep_task_open_after_focus">Keep task open</button>
                        <button variant="primary" icon="check" disabled="{saving or hasWriteError}" on-press="complete_task_after_focus">Mark task complete</button>
                      </row>
                      <button variant="ghost" icon="clock" disabled="{saving or hasWriteError}" on-press="start_break">Keep it open and take a {nextBreakMinutes} min break</button>
                    </column>
                  </column>
                </if>
              </column>

              <!--
                The day's ledger totals stay visible under every state. This is
                the pane's honest floor: it never invents a number the Ledger
                would contradict.
              -->
              <separator />
              <row padding="16" gap="20" cross="center" label="Today's recorded focus">
                <column width="112" gap="2">
                  <text size="sm" foreground="text_muted">Focused today</text>
                  <text><span weight="medium" mono="true">{todayFocusText}</span></text>
                </column>
                <column width="96" gap="2">
                  <text size="sm" foreground="text_muted">Blocks</text>
                  <text><span weight="medium" mono="true">{todayBlockCount} {plural(todayBlockCount, 'block', 'blocks')}</span></text>
                </column>
                <!--
                  Facts, not pressure. The ledger deliberately carries no
                  streak, score, or attention grade, so this strip states only
                  what was recorded.
                -->
                <column width="112" gap="2">
                  <text size="sm" foreground="text_muted">Last seven days</text>
                  <text label="{'Focused ' ++ focusedWeekText ++ ' in the last seven days'}"><span weight="medium" mono="true">{focusedWeekText}</span></text>
                </column>
                <column grow="1" gap="6">
                  <row gap="8" cross="center">
                    <text size="sm" grow="1" foreground="text_muted">Daily goal</text>
                    <if test="{todayGoalReached}">
                      <text size="sm" foreground="success"><span weight="medium">Daily goal reached</span></text>
                    </if>
                    <else>
                      <text size="sm" foreground="text_muted">{todayGoalText} · {todayGoalRemainingText}</text>
                    </else>
                  </row>
                  <progress height="6" value="{todayGoalProgress}" label="Daily focus goal progress" />
                </column>
              </row>
            </column>
          </split>
        </if>

        <else>
          <!-- Ledger is bounded and factual: one summary, one honest chart. -->
          <scroll grow="1" overscroll="rubber_band">
            <row main="center">
              <column width="880" padding="24" gap="16">
                <row gap="16" cross="end">
                  <column gap="4" grow="1">
                    <text size="heading"><span weight="bold">Focus ledger</span></text>
                    <text wrap="true" foreground="text_muted">Completed focus blocks and totals.</text>
                  </column>
                  <badge variant="secondary">{weekSessionText}</badge>
                </row>

                <row background="surface_subtle" radius="lg" padding="16" gap="32" cross="end">
                  <column gap="4" grow="1">
                    <text foreground="text_muted">Last seven days</text>
                    <if test="{hasFullWeekMinute}">
                      <text size="display" label="{focusedWeekText}">
                        <span mono="true" weight="medium">{focusedWeekText}</span>
                      </text>
                    </if>
                    <else>
                      <if test="{hasWeekFocus}">
                        <text><span weight="medium">First focus recorded</span></text>
                        <text size="sm" foreground="text_muted">Less than one focused minute</text>
                      </if>
                      <else>
                        <text size="heading" label="{focusedWeekText}">
                          <span mono="true" weight="medium">{focusedWeekText}</span>
                        </text>
                      </else>
                    </else>
                  </column>
                  <column width="300" gap="8">
                    <row cross="center">
                      <text grow="1"><span weight="medium">Today</span></text>
                      <text foreground="text_muted">{todayGoalText}</text>
                    </row>
                    <progress value="{todayGoalProgress}" label="Daily focus goal progress" />
                  </column>
                </row>

                <!-- Three facts the bar chart alone cannot state. -->
                <row gap="16">
                  <column grow="1" background="surface" radius="lg" padding="16" gap="4" label="Days with recorded focus this week">
                    <text size="sm" foreground="text_muted">Days focused</text>
                    <text size="heading"><span mono="true" weight="medium">{weekActiveDays} of 7</span></text>
                  </column>
                  <column grow="1" background="surface" radius="lg" padding="16" gap="4" label="Average focus on days with recorded focus">
                    <text size="sm" foreground="text_muted">Average active day</text>
                    <text size="heading"><span mono="true" weight="medium">{weekAverageText}</span></text>
                  </column>
                  <column grow="1" background="surface" radius="lg" padding="16" gap="4" label="Best focused day this week">
                    <text size="sm" foreground="text_muted">Best day</text>
                    <text size="heading"><span mono="true" weight="medium">{weekBestText}</span></text>
                  </column>
                </row>

                <column background="surface" radius="lg" padding="16" gap="12">
                  <row gap="12" cross="center">
                    <column gap="4" grow="1">
                      <text><span weight="medium">Focus by day</span></text>
                      <text size="sm" foreground="text_muted">Minutes of completed focus</text>
                    </column>
                    <text size="sm" foreground="text_muted">Scaled to your {dailyGoalMinutes} min goal</text>
                  </row>

                  <if test="{hasFullWeekMinute}">
                    <chart
                      height="150"
                      y-min="0"
                      y-max="{weekChartMaxMinutes}"
                      x-labels="{weekDayLabels}"
                      grid-lines="3"
                      hover-details="true"
                      label="Focus minutes by day"
                    >
                      <series kind="bar" values="{weekMinutes}" color="accent" label="Minutes" />
                    </chart>

                    <row main="space_between">
                      <for each="weekDays" key="id" as="d">
                        <column width="88" gap="4" cross="center" label="{d.accessibilityLabel}">
                          <if test="{d.today}">
                            <badge variant="secondary">Today · {d.valueText}</badge>
                          </if>
                          <else>
                            <text size="sm" foreground="text_muted"><span mono="true">{d.valueText}</span></text>
                          </else>
                        </column>
                      </for>
                    </row>
                  </if>

                  <else>
                    <if test="{hasWeekFocus}">
                      <column background="surface_subtle" radius="lg" padding="12" gap="4" label="First focus recorded">
                        <text><span weight="medium">First focus recorded</span></text>
                        <text size="sm" wrap="true" foreground="text_muted">Your first full minute will appear here.</text>
                      </column>
                    </if>
                    <else>
                      <column padding="24" gap="8" main="center" cross="center" label="No focus recorded in the last seven days">
                        <text><span weight="medium">No focus recorded this week</span></text>
                        <text width="360" wrap="true" text-alignment="center" foreground="text_muted">Complete a block to add data to this chart.</text>
                      </column>
                    </else>
                  </else>
                </column>

                <column background="surface" radius="lg" padding="16" gap="12">
                  <row gap="12" cross="center">
                    <column gap="4" grow="1">
                      <text><span weight="medium">Recent blocks</span></text>
                      <text size="sm" foreground="text_muted">Newest first · latest 14</text>
                    </column>
                  </row>

                  <if test="{hasHistory}">
                    <timeline gap="4" label="Focus session history">
                      <for each="historySessions" key="id" as="s">
                        <timeline-item
                          global-key="{s.id}"
                          title="{s.taskTitle}"
                          description="{s.durationLabel}"
                          meta="{s.meta}"
                          variant="{s.tone}"
                          connector="{s.connector}"
                        />
                      </for>
                    </timeline>
                  </if>

                  <else>
                    <column padding="24" gap="12" main="center" cross="center">
                      <icon name="clock" foreground="text_muted" />
                      <text text-alignment="center"><span weight="bold">Your ledger is ready</span></text>
                      <text width="360" wrap="true" text-alignment="center" foreground="text_muted">Complete one block and its time will appear here.</text>
                      <button variant="primary" on-press="show_today">Return to Today</button>
                    </column>
                  </else>
                </column>
              </column>
            </row>
          </scroll>
        </else>
      </else>
    </else>
  </column>

  <if test="{mainEndDialogOpen and not isBreak}">
    <column main="center" cross="center">
      <dialog text="Finish this focus block?" width="480" padding="24" on-dismiss="cancel_end_focus">
        <column gap="16">
          <spacer height="16" />
          <text wrap="true" foreground="text_muted">Keep the focused time so far, or discard this unfinished block.</text>
          <row gap="8" main="end">
            <button variant="ghost" autofocus="true" on-press="cancel_end_focus">Continue focusing</button>
            <button variant="destructive" disabled="{saving or hasWriteError}" on-press="confirm_end_focus">Discard block</button>
            <button variant="primary" icon="check" disabled="{saving or hasWriteError}" on-press="finish_focus_now">Record elapsed time</button>
          </row>
        </column>
      </dialog>
    </column>
  </if>

  <if test="{mainEndDialogOpen and isBreak}">
    <column main="center" cross="center">
      <dialog text="Finish this break?" width="480" padding="24" on-dismiss="cancel_end_focus">
        <column gap="16">
          <spacer height="16" />
          <text wrap="true" foreground="text_muted">Keep the rest taken so far, or discard this unfinished break.</text>
          <row gap="8" main="end">
            <button variant="ghost" autofocus="true" on-press="cancel_end_focus">Continue break</button>
            <button variant="destructive" disabled="{saving or hasWriteError}" on-press="confirm_end_focus">Discard break</button>
            <button variant="primary" icon="check" disabled="{saving or hasWriteError}" on-press="finish_focus_now">Record break so far</button>
          </row>
        </column>
      </dialog>
    </column>
  </if>

  <if test="{purgeDialogOpen}">
    <column grow="1" padding="32" main="center" cross="center">
      <dialog text="Delete this task permanently?" width="500" padding="24" on-dismiss="cancel_purge_task">
        <column gap="16">
          <spacer height="16" />
          <text><span weight="bold">{purgeTaskTitle}</span></text>
          <text wrap="true">This removes the task from your archive and cannot be undone.</text>
          <text wrap="true" foreground="text_muted">Recorded focus time stays in the Ledger, but the task name and session association are removed.</text>
          <row gap="8" main="end">
            <button key="{purgeFocusKey}" variant="ghost" autofocus="{purgeAutofocus}" disabled="{saving}" on-press="cancel_purge_task">Cancel</button>
            <button variant="destructive" disabled="{saving or hasWriteError}" on-press="confirm_purge_task">Delete permanently</button>
          </row>
        </column>
      </dialog>
    </column>
  </if>
</stack>
