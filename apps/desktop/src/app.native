<!--
  Focus Tracker — Cobalt Chronograph

  The task ledger is deliberately quiet. Committing to a block contracts
  the rail and turns the focus chamber into the primary instrument.
-->
<stack>
  <column background="background" grow="1">
    <!-- Native toolbar: identity, navigation, and current daily status. -->
    <row window-drag="true" height="{headerHeight}" padding="8" gap="12" cross="center">
      <spacer width="{chromeLeading}" />
      <column width="112" gap="2">
        <text size="sm" foreground="accent"><span weight="bold">FOCUS</span></text>
        <text><span weight="medium">Tracker</span></text>
      </column>

      <tabs label="Workspace sections" gap="12">
        <button
          size="sm"
          selected="{section == 'today'}"
          on-press="show_today"
        >Today</button>
        <button
          size="sm"
          selected="{section == 'ledger'}"
          on-press="show_ledger"
        >Ledger</button>
      </tabs>

      <spacer grow="1" />

      <column width="220" gap="4">
        <row cross="center">
          <text size="sm" grow="1" foreground="text_muted">{goalRemainingText}</text>
          <text size="sm" foreground="text_muted">{todayFocusedText}</text>
        </row>
        <progress height="3" value="{todayGoalProgress}" label="Daily focus goal progress" />
      </column>

      <row width="88" main="end" cross="center">
        <if test="{saving}">
          <row gap="8" cross="center" label="Saving changes">
            <spinner />
            <text size="sm" foreground="text_muted">Saving</text>
          </row>
        </if>
      </row>

      <stack>
        <button
          size="icon"
          variant="ghost"
          icon="clock"
          label="Open Quick Focus"
          on-press="open_quick"
        ></button>
        <tooltip anchor="below">Quick Focus</tooltip>
      </stack>
    </row>

    <separator />

    <!-- Boot keeps the final composition visible while SQLite opens. -->
    <if test="{loadState == 'loading'}">
      <row grow="1" label="Loading Focus Tracker local data">
        <column width="380" background="surface_subtle" padding="20" gap="16">
          <skeleton width="160" height="26" />
          <skeleton width="340" height="32" />
          <skeleton width="228" height="32" />
          <column gap="8">
            <skeleton width="340" height="52" />
            <skeleton width="340" height="52" />
            <skeleton width="340" height="52" />
          </column>
        </column>
        <separator />
        <column grow="1" padding="32" gap="20" main="center" cross="center">
          <skeleton width="120" height="20" />
          <skeleton width="420" height="180" />
          <row gap="8" cross="center" label="Opening local focus ledger">
            <spinner />
            <text foreground="text_muted">Opening your local ledger</text>
          </row>
        </column>
      </row>
    </if>

    <else>
      <if test="{loadState == 'fatal'}">
        <row grow="1" main="center" cross="center" padding="32">
          <alert text="Focus Tracker could not open" width="520">
            <column gap="16">
              <text wrap="true" foreground="text_muted">{fatalErrorText}</text>
              <row gap="8">
                <button variant="primary" icon="refresh-cw" on-press="retry_boot">Try again</button>
                <button variant="ghost" on-press="quit_app">Quit</button>
              </row>
            </column>
          </alert>
        </row>
      </if>

      <else>
        <if test="{hasWriteError}">
          <alert text="The latest change was not saved">
            <column gap="8">
              <text wrap="true" foreground="text_muted">{writeErrorText}</text>
              <row gap="8">
                <button size="sm" variant="outline" icon="refresh-cw" on-press="retry_save">Retry save</button>
                <button size="sm" variant="ghost" on-press="discard_failed_change">Discard change</button>
              </row>
            </column>
          </alert>
        </if>

        <if test="{section == 'today'}">
          <split
            grow="1"
            gap="1"
            value="{paneFraction}"
            on-resize="pane_resized"
            resize-duration="260"
            resize-easing="spring"
          >
            <!-- Task rail. It contracts when a block starts, but stays useful. -->
            <column min-width="248" background="surface_subtle" padding="16" gap="14">
              <row gap="12" cross="center">
                <column grow="1" gap="2">
                  <text size="sm" foreground="accent"><span weight="bold">DAILY QUEUE</span></text>
                  <text foreground="text_muted">Select the next task.</text>
                </column>
                <text size="sm" foreground="text_muted">{filterCountText}</text>
              </row>

              <if test="{sessionState == 'idle'}">
                <row gap="8" cross="center">
                  <text-field
                    key="{composerKey}"
                    grow="1"
                    text="{taskDraft}"
                    placeholder="Add the next concrete action"
                    label="New task"
                    autofocus="{mainComposerAutofocus}"
                    on-input="task_draft_edit"
                    on-submit="add_task"
                  />
                  <stack>
                    <button
                    size="icon"
                    variant="ghost"
                    icon="plus"
                    label="Add task"
                    disabled="{not canAddTask}"
                    on-press="add_task"
                    ></button>
                    <tooltip anchor="above">Add task</tooltip>
                  </stack>
                </row>

                <row>
                  <tabs label="Task filter" gap="2">
                    <button size="sm" selected="{taskFilter == 'open'}" autofocus="{focusRecoveryKind == 'task_filter' and taskFilter == 'open'}" on-press="show_open_tasks">Open</button>
                    <button size="sm" selected="{taskFilter == 'completed'}" autofocus="{focusRecoveryKind == 'task_filter' and taskFilter == 'completed'}" on-press="show_completed_tasks">Completed</button>
                    <button size="sm" selected="{taskFilter == 'archived'}" autofocus="{focusRecoveryKind == 'task_filter' and taskFilter == 'archived'}" on-press="show_archived_tasks">Archived</button>
                  </tabs>
                </row>
              </if>

              <else>
                <if test="{sessionState == 'complete'}">
                  <row background="surface" radius="lg" padding="12" cross="center" label="Focus block recorded">
                    <column gap="4" grow="1">
                      <text><span weight="medium">Focus recorded</span></text>
                      <if test="{completionHasTask}">
                        <text size="sm" wrap="true" foreground="text_muted">Attached task remains open.</text>
                      </if>
                      <else>
                        <text size="sm" wrap="true" foreground="text_muted">Unassigned block saved to Ledger.</text>
                      </else>
                    </column>
                  </row>
                </if>
                <else>
                  <row background="surface" radius="lg" padding="12" cross="center">
                    <column gap="4" grow="1">
                      <if test="{sessionState == 'paused'}">
                        <if test="{isBreak}">
                          <text><span weight="medium">Break paused</span></text>
                          <text foreground="text_muted">Rest is held until you resume.</text>
                        </if>
                        <else>
                          <text><span weight="medium">Focus block paused</span></text>
                          <text foreground="text_muted">Time is held until you resume.</text>
                        </else>
                      </if>
                      <else>
                        <if test="{isBreak}">
                          <text><span weight="medium">Break in progress</span></text>
                        </if>
                        <else>
                          <text><span weight="medium">Focus block in progress</span></text>
                        </else>
                      </else>
                    </column>
                  </row>
                </else>
              </else>

              <scroll grow="1" overscroll="rubber_band">
                <list gap="4" label="{taskListLabel}">
                  <for each="visibleTasks" key="id" as="t">
                    <list-item
                      global-key="{t.id}"
                      selected="{t.id == actionTaskId}"
                      autofocus="{t.autofocus}"
                      on-press="select_task:{t.id}"
                      label="{t.title}"
                    >
                      <!--
                        Leading gutter. Trailing controls are icon buttons and
                        badges that carry their own optical inset, so the row
                        needs this to sit symmetrically inside the selection wash.
                      -->
                      <spacer width="8" />
                      <if test="{t.archived}">
                        <icon name="archive" foreground="text_muted" />
                      </if>
                      <else>
                        <checkbox
                          checked="{t.done}"
                          disabled="{saving or hasWriteError or sessionState != 'idle'}"
                          label="{t.toggleLabel}"
                          on-toggle="toggle_task:{t.id}"
                        />
                      </else>
                      <spacer width="8" />

                      <if test="{t.id == editTaskId}">
                        <text-field
                          key="{editFocusKey}"
                          grow="1"
                          text="{editDraft}"
                          placeholder="Task title"
                          label="{t.renameLabel}"
                          autofocus="{editAutofocus}"
                          on-input="edit_draft_edit"
                          on-submit="commit_rename"
                        />
                        <button
                          icon="x"
                          size="icon"
                          variant="ghost"
                          label="{t.cancelRenameLabel}"
                          on-press="cancel_rename"
                        ></button>
                        <button
                          icon="check"
                          size="icon"
                          variant="secondary"
                          disabled="{not canCommitRename}"
                          label="{t.saveRenameLabel}"
                          on-press="commit_rename"
                        ></button>
                      </if>

                      <else>
                        <if test="{t.done}">
                          <text grow="1" foreground="text_muted" overflow="ellipsis">{t.title}</text>
                        </if>
                        <else>
                          <text grow="1" overflow="ellipsis">{t.title}</text>
                        </else>
                        <!-- The leading archive icon already states the state. -->
                        <if test="{t.archived and t.id == actionTaskId and sessionState == 'idle'}">
                          <button
                            variant="ghost"
                            icon="refresh-cw"
                            disabled="{saving or hasWriteError}"
                            label="{t.restoreLabel}"
                            on-press="restore_task:{t.id}"
                          >Restore</button>
                          <button
                            size="icon"
                            variant="ghost"
                            icon="trash"
                            autofocus="{t.purgeAutofocus}"
                            disabled="{saving or hasWriteError}"
                            label="{t.purgeLabel}"
                            on-press="request_purge_task:{t.id}"
                          ></button>
                        </if>

                        <if test="{not t.archived and t.id == actionTaskId and sessionState == 'idle'}">
                          <stack>
                            <button
                              size="icon"
                              variant="ghost"
                              icon="ellipsis"
                              selected="{taskActionsTaskId == t.id}"
                              disabled="{saving or hasWriteError}"
                              label="More task actions"
                              on-press="toggle_task_actions:{t.id}"
                            ></button>
                            <if test="{taskActionsTaskId == t.id}">
                              <dropdown-menu
                                width="184"
                                anchor="below"
                                anchor-alignment="end"
                                label="Task actions"
                                on-dismiss="dismiss_task_actions"
                              >
                                <if test="{t.done}">
                                  <menu-item on-press="toggle_task:{t.id}">Reopen task</menu-item>
                                </if>
                                <else>
                                  <menu-item on-press="start_focus_task:{t.id}">Focus this task</menu-item>
                                </else>
                                <menu-item on-press="begin_rename:{t.id}">Rename</menu-item>
                                <separator />
                                <menu-item on-press="delete_task:{t.id}">Archive</menu-item>
                              </dropdown-menu>
                            </if>
                          </stack>
                        </if>
                      </else>

                      <context-menu>
                        <if test="{t.archived}">
                          <menu-item disabled="{saving or hasWriteError or sessionState != 'idle'}" on-press="restore_task:{t.id}">{t.restoreLabel}</menu-item>
                          <separator />
                          <menu-item disabled="{saving or hasWriteError or sessionState != 'idle'}" on-press="request_purge_task:{t.id}">{t.purgeLabel}</menu-item>
                        </if>
                        <else>
                          <if test="{t.done}">
                            <menu-item disabled="{saving or hasWriteError or sessionState != 'idle'}" on-press="toggle_task:{t.id}">{t.toggleLabel}</menu-item>
                          </if>
                          <else>
                            <menu-item disabled="{saving or hasWriteError or sessionState != 'idle'}" on-press="start_focus_task:{t.id}">{t.focusLabel}</menu-item>
                          </else>
                          <menu-item disabled="{saving or hasWriteError or sessionState != 'idle'}" on-press="begin_rename:{t.id}">{t.renameLabel}</menu-item>
                          <separator />
                          <menu-item disabled="{saving or hasWriteError or sessionState != 'idle'}" on-press="delete_task:{t.id}">{t.archiveLabel}</menu-item>
                        </else>
                      </context-menu>
                    </list-item>
                  </for>

                  <else>
                    <column padding="24" gap="8" main="center" cross="center">
                      <if test="{taskFilter == 'open'}">
                        <text text-alignment="center"><span weight="bold">No open tasks</span></text>
                        <text width="230" wrap="true" text-alignment="center" foreground="text_muted">Add a task to prepare your next focus block.</text>
                      </if>
                      <if test="{taskFilter == 'completed'}">
                        <text text-alignment="center"><span weight="bold">Nothing completed yet</span></text>
                        <text width="230" wrap="true" text-alignment="center" foreground="text_muted">Finished work stays here without crowding the day.</text>
                      </if>
                      <if test="{taskFilter == 'archived'}">
                        <text text-alignment="center"><span weight="bold">The archive is empty</span></text>
                        <text width="230" wrap="true" text-alignment="center" foreground="text_muted">Archived tasks remain recoverable.</text>
                      </if>
                    </column>
                  </else>
                </list>
              </scroll>

              <if test="{hasUndo}">
                <row background="surface" radius="lg" padding="12" gap="8" cross="center">
                  <text grow="1" overflow="ellipsis">{undoText}</text>
                  <button size="sm" variant="ghost" disabled="{saving or hasWriteError}" on-press="undo_delete">Undo</button>
                  <button icon="x" size="icon" variant="ghost" label="Dismiss undo" on-press="dismiss_undo"></button>
                </row>
              </if>
            </column>

            <!-- Timer workspace. -->
            <column min-width="540" grow="1" background="background">
              <column padding="16" gap="8">
                <row gap="12" cross="start">
                  <column grow="1" gap="2">
                    <text size="sm" foreground="accent"><span weight="bold">FOCUS TIMER</span></text>
                    <if test="{isBreak}">
                      <text foreground="text_muted">Break in progress</text>
                    </if>
                    <else>
                      <if test="{sessionState == 'running' or sessionState == 'paused'}">
                        <text foreground="text_muted">Focus block in progress</text>
                      </if>
                      <else>
                        <text foreground="text_muted">Choose a task and set a duration.</text>
                      </else>
                    </else>
                  </column>
                  <column width="210" gap="4">
                    <row gap="8" cross="center">
                      <text size="sm" grow="1" foreground="text_muted">Daily focus</text>
                      <text size="sm" text-alignment="end" foreground="text_muted">{todayGoalText}</text>
                    </row>
                    <progress height="4" value="{todayGoalProgress}" label="Daily focus goal progress" />
                  </column>
                </row>
              </column>

              <separator />

              <column grow="1" padding="16">
                <if test="{sessionState == 'idle'}">
                  <column grow="1" gap="20">
                    <if test="{breakAcknowledgementOpen}">
                      <row background="surface" radius="lg" padding="12" gap="12" cross="center" label="Break recorded">
                        <column gap="4" grow="1">
                          <text><span weight="medium">Break recorded</span></text>
                          <text size="sm" foreground="text_muted">{breakCompletionSummary} Your queue is unchanged.</text>
                        </column>
                        <button
                          size="icon"
                          variant="ghost"
                          icon="x"
                          label="Dismiss break record"
                          on-press="dismiss_break_acknowledgement"
                        ></button>
                      </row>
                    </if>

                    <spacer grow="1" />

                    <if test="{selectedTaskExists}">
                      <column gap="20" label="Selected focus block">
                        <row cross="center">
                          <badge variant="primary">NEXT BLOCK</badge>
                          <spacer grow="1" />
                          <text size="sm" foreground="text_muted">Space starts the block</text>
                        </row>

                        <column gap="8">
                          <text size="heading" overflow="ellipsis">{focusTaskTitle}</text>
                          <text wrap="true" foreground="text_muted">The selected task stays attached to this focus block.</text>
                        </column>

                        <row background="surface" radius="xl" padding="24" gap="32" cross="end">
                          <column grow="1" gap="4">
                            <text size="sm" foreground="text_muted">DURATION</text>
                            <text size="display" label="{selectedFocusIntervalLabel}">
                              <span mono="true" weight="medium" scale="1.18">{pad(focusLengthMinutes, 2)}:00</span>
                            </text>
                          </column>

                          <column width="300" gap="12">
                            <toggle-group label="Focus length" gap="2">
                              <toggle-button size="sm" selected="{focusLengthMinutes == 15}" disabled="{saving or hasWriteError}" on-toggle="set_duration_15">15</toggle-button>
                              <toggle-button size="sm" selected="{focusLengthMinutes == 25}" disabled="{saving or hasWriteError}" on-toggle="set_duration_25">25</toggle-button>
                              <toggle-button size="sm" selected="{focusLengthMinutes == 50}" disabled="{saving or hasWriteError}" on-toggle="set_duration_50">50</toggle-button>
                              <toggle-button size="sm" selected="{focusLengthMinutes == 90}" disabled="{saving or hasWriteError}" on-toggle="set_duration_90">90</toggle-button>
                            </toggle-group>
                            <button
                              key="{mainStartFocusKey}"
                              size="lg"
                              variant="primary"
                              icon="play"
                              autofocus="{startAutofocus and not purgeDialogOpen}"
                              disabled="{saving or hasWriteError}"
                              on-press="start_focus"
                            >Begin focused work</button>
                            <button variant="ghost" disabled="{saving or hasWriteError}" on-press="start_unassigned_focus">Focus without attaching this task</button>
                            <text size="sm" text-alignment="center" foreground="text_muted">This choice applies to this block only.</text>
                          </column>
                        </row>
                      </column>
                    </if>

                    <else>
                      <column gap="20" label="Choose a focus task">
                        <row>
                          <badge variant="secondary">NO TASK SELECTED</badge>
                        </row>
                        <column gap="8">
                          <text size="heading"><span weight="medium">Start a focus block</span></text>
                          <text wrap="true" foreground="text_muted">Select a task from the queue, or continue without attaching one.</text>
                        </column>
                        <if test="{taskFilter == 'open'}">
                          <row background="surface" radius="xl" padding="20" gap="20" cross="center">
                            <column grow="1" gap="8">
                              <text size="sm" foreground="text_muted">BLOCK LENGTH</text>
                              <toggle-group label="Focus length" gap="2">
                                <toggle-button size="sm" selected="{focusLengthMinutes == 15}" on-toggle="set_duration_15">15</toggle-button>
                                <toggle-button size="sm" selected="{focusLengthMinutes == 25}" on-toggle="set_duration_25">25</toggle-button>
                                <toggle-button size="sm" selected="{focusLengthMinutes == 50}" on-toggle="set_duration_50">50</toggle-button>
                                <toggle-button size="sm" selected="{focusLengthMinutes == 90}" on-toggle="set_duration_90">90</toggle-button>
                              </toggle-group>
                            </column>
                            <column width="260" gap="8">
                              <button size="lg" variant="primary" icon="play" disabled="{saving or hasWriteError}" on-press="start_unassigned_focus">Focus without a task</button>
                              <button variant="ghost" icon="clock" disabled="{saving or hasWriteError}" on-press="start_break">Take a {nextBreakMinutes} min break</button>
                            </column>
                          </row>
                        </if>
                        <else>
                          <text wrap="true" foreground="text_muted">Return to open tasks to choose your next block.</text>
                          <row>
                            <button variant="outline" on-press="show_open_tasks">Show open tasks</button>
                          </row>
                        </else>
                      </column>
                    </else>

                    <spacer grow="1" />

                    <row gap="20" cross="center" label="Today at a glance">
                      <column gap="2" grow="1">
                        <text size="sm" foreground="text_muted">FOCUSED</text>
                        <text><span mono="true" weight="medium">{todayFocusedText}</span></text>
                      </column>
                      <separator />
                      <column gap="2" grow="1">
                        <text size="sm" foreground="text_muted">FOCUS BLOCKS</text>
                        <text><span mono="true" weight="medium">{todayBlocksText}</span></text>
                      </column>
                      <separator />
                      <column gap="2" grow="1">
                        <text size="sm" foreground="text_muted">TASKS CLOSED</text>
                        <text><span mono="true" weight="medium">{todayTasksText}</span></text>
                      </column>
                    </row>
                  </column>
                </if>

                <else>
                  <column grow="1" padding="28" gap="20">
                    <if test="{sessionState == 'running' or sessionState == 'paused'}">
                      <row background="surface_subtle" radius="xl" padding="16" gap="20" cross="center">
                        <column gap="3" grow="1">
                          <if test="{sessionState == 'paused'}">
                            <text size="sm" foreground="accent"><span weight="bold">PAUSED</span></text>
                          </if>
                          <else>
                            <if test="{isBreak}">
                              <text size="sm" foreground="accent"><span weight="bold">BREAK RUNNING</span></text>
                            </if>
                            <else>
                              <text size="sm" foreground="accent"><span weight="bold">FOCUS BLOCK RUNNING</span></text>
                            </else>
                          </else>
                          <text overflow="ellipsis">{focusTaskTitle}</text>
                        </column>
                        <badge variant="secondary">{focusLengthMinutes} MIN BLOCK</badge>
                      </row>

                      <spacer grow="1" />

                      <column gap="20" cross="center" label="{timerA11y}">
                        <text size="display" text-alignment="center">
                          <span mono="true" weight="medium" scale="2.05">{pad(remainingMinutes, 2)}:{pad(remainingSeconds, 2)}</span>
                        </text>
                        <column width="560" gap="8">
                          <row>
                            <if test="{isBreak}">
                              <text size="sm" grow="1" foreground="text_muted">Break</text>
                            </if>
                            <else>
                              <text size="sm" grow="1" foreground="text_muted">Focus block</text>
                            </else>
                            <text size="sm" foreground="text_muted">{focusLengthMinutes} min</text>
                          </row>
                          <if test="{isBreak}">
                            <progress height="8" value="{focusProgress}" label="Break progress" />
                          </if>
                          <else>
                            <progress height="8" value="{focusProgress}" label="Focus block progress" />
                          </else>
                        </column>
                      </column>

                      <spacer grow="1" />

                      <if test="{sessionState == 'running'}">
                        <row gap="8" main="center" label="Timer controls">
                          <button key="running-primary" size="lg" variant="primary" icon="pause" autofocus="{transportAutofocus and not endDialogOpen}" disabled="{saving or hasWriteError}" on-press="pause_focus">Pause</button>
                          <if test="{isBreak}">
                            <button size="lg" variant="ghost" disabled="{saving or hasWriteError}" on-press="request_end_focus">End break…</button>
                          </if>
                          <else>
                            <button size="lg" variant="ghost" disabled="{saving or hasWriteError}" on-press="request_end_focus">Finish block…</button>
                          </else>
                        </row>
                      </if>
                      <else>
                        <row gap="8" main="center" label="Paused timer controls">
                          <button key="paused-primary" size="lg" variant="primary" icon="play" autofocus="{transportAutofocus and not endDialogOpen}" disabled="{saving or hasWriteError}" on-press="resume_focus">Resume</button>
                          <if test="{isBreak}">
                            <button size="lg" variant="ghost" disabled="{saving or hasWriteError}" on-press="request_end_focus">End break…</button>
                          </if>
                          <else>
                            <button size="lg" variant="ghost" disabled="{saving or hasWriteError}" on-press="request_end_focus">Finish block…</button>
                          </else>
                        </row>
                      </else>
                      <text size="sm" text-alignment="center" foreground="text_muted">Press Space to pause or resume.</text>
                    </if>

                    <if test="{sessionState == 'complete'}">
                      <spacer grow="1" />
                      <column gap="18" main="center" cross="center" label="Recorded focus block">
                        <column width="72" height="72" background="surface_subtle" radius="xl" main="center" cross="center">
                          <icon name="check" size="lg" foreground="accent" />
                        </column>
                        <column gap="6" cross="center">
                          <text size="sm" foreground="accent"><span weight="bold">BLOCK RECORDED</span></text>
                          <text size="heading" text-alignment="center"><span weight="medium">Focus block saved.</span></text>
                          <text width="520" wrap="true" text-alignment="center" foreground="text_muted">{completionSummary}</text>
                        </column>

                        <if test="{completionHasTask}">
                          <column width="520" background="surface_subtle" radius="xl" padding="16" gap="6" cross="center">
                            <text size="sm" foreground="text_muted">TASK STILL OPEN</text>
                            <text overflow="ellipsis" text-alignment="center">{focusTaskTitle}</text>
                          </column>
                          <row gap="8" main="center" label="Task and recovery choices">
                            <button variant="outline" icon="check" disabled="{saving or hasWriteError}" on-press="complete_task_after_focus">Mark task complete</button>
                            <button key="complete-safe" variant="secondary" autofocus="true" disabled="{saving or hasWriteError}" on-press="keep_task_open_after_focus">Back to queue</button>
                            <button variant="primary" icon="clock" disabled="{saving or hasWriteError}" on-press="start_break">Start {nextBreakMinutes} min break</button>
                          </row>
                        </if>
                        <else>
                          <text width="520" wrap="true" text-alignment="center" foreground="text_muted">No task was attached to this block. The focused time is safely in your Ledger.</text>
                          <row gap="8" main="center" label="Break choices">
                            <button key="complete-safe" variant="secondary" autofocus="true" disabled="{saving or hasWriteError}" on-press="keep_task_open_after_focus">Back to queue</button>
                            <button variant="primary" icon="clock" disabled="{saving or hasWriteError}" on-press="start_break">Start {nextBreakMinutes} min break</button>
                          </row>
                        </else>
                      </column>
                      <spacer grow="1" />
                    </if>
                  </column>
                </else>
              </column>

            </column>
          </split>
        </if>

        <else>
          <scroll grow="1" overscroll="rubber_band">
            <row main="center">
              <column width="900" padding="28" gap="24">
                <row gap="24" cross="end">
                  <column gap="5" grow="1">
                    <text size="sm" foreground="accent"><span weight="bold">LEDGER</span></text>
                    <text size="heading"><span weight="medium">Focus history</span></text>
                    <text wrap="true" foreground="text_muted">Weekly totals and recent completed blocks. Cancelled blocks are excluded.</text>
                  </column>
                  <badge variant="secondary">{weekSessionText}</badge>
                </row>

                <separator />

                <row gap="40" cross="end" label="Weekly focus summary">
                  <column gap="4" grow="1">
                    <text size="sm" foreground="text_muted">FOCUSED THIS WEEK</text>
                    <if test="{hasFullWeekMinute}">
                      <text size="display" label="{focusedWeekText}"><span mono="true" weight="medium">{focusedWeekText}</span></text>
                    </if>
                    <else>
                      <if test="{hasWeekFocus}">
                        <text size="heading"><span weight="medium">Less than 1 min recorded</span></text>
                      </if>
                      <else>
                        <text size="display" label="{focusedWeekText}"><span mono="true" weight="medium">{focusedWeekText}</span></text>
                      </else>
                    </else>
                  </column>
                  <column width="320" gap="10">
                    <row cross="center">
                      <text size="sm" grow="1" foreground="text_muted">TODAY'S PROGRESS</text>
                      <text><span mono="true" weight="medium">{todayGoalText}</span></text>
                    </row>
                    <progress height="8" value="{todayGoalProgress}" label="Daily focus goal progress" />
                    <text size="sm" foreground="text_muted">{goalRemainingText}</text>
                  </column>
                </row>

                <row background="surface_subtle" radius="xl" padding="16" gap="20" label="Today metrics">
                  <column grow="1" gap="3">
                    <text size="sm" foreground="text_muted">FOCUSED</text>
                    <text><span mono="true" weight="medium">{todayFocusedText}</span></text>
                  </column>
                  <separator />
                  <column grow="1" gap="3">
                    <text size="sm" foreground="text_muted">FOCUS BLOCKS</text>
                    <text><span mono="true" weight="medium">{todayBlocksText}</span></text>
                  </column>
                  <separator />
                  <column grow="1" gap="3">
                    <text size="sm" foreground="text_muted">TASKS CLOSED</text>
                    <text><span mono="true" weight="medium">{todayTasksText}</span></text>
                  </column>
                </row>

                <separator />

                <column gap="14" label="Focus by day">
                  <row gap="12" cross="center">
                    <column gap="3" grow="1">
                      <text><span weight="medium">Focus by day</span></text>
                      <text size="sm" foreground="text_muted">Completed focus minutes · goal line {dailyGoalMinutes} min</text>
                    </column>
                  </row>

                  <if test="{hasFullWeekMinute}">
                    <chart height="170" y-min="0" y-max="{weekChartMaxMinutes}" x-labels="{weekDayLabels}" grid-lines="3" hover-details="true" label="Focus minutes by day">
                      <series kind="bar" values="{weekMinutes}" color="accent" label="Minutes" />
                    </chart>
                    <row main="space_between">
                      <for each="weekDays" key="id" as="d">
                        <column width="96" gap="4" cross="center" label="{d.accessibilityLabel}">
                          <if test="{d.today}">
                            <badge variant="secondary">Today · {d.valueText}</badge>
                          </if>
                          <else>
                            <text size="sm" foreground="text_muted"><span mono="true">{d.valueText}</span></text>
                          </else>
                        </column>
                      </for>
                    </row>
                  </if>
                  <else>
                    <column height="150" gap="7" main="center" cross="center" label="No complete focus minutes in the last seven days">
                      <if test="{hasWeekFocus}">
                        <text><span weight="medium">Less than 1 min recorded.</span></text>
                        <text size="sm" foreground="text_muted">The chart appears after one full focused minute.</text>
                      </if>
                      <else>
                        <text><span weight="medium">No focus recorded this week.</span></text>
                        <text width="420" wrap="true" text-alignment="center" foreground="text_muted">Complete a focus block to add its minutes to this chart.</text>
                      </else>
                    </column>
                  </else>
                </column>

                <separator />

                <column gap="14" label="Recent blocks">
                  <row gap="12" cross="center">
                    <column gap="3" grow="1">
                      <text><span weight="medium">Recent entries</span></text>
                      <text size="sm" foreground="text_muted">Newest first · latest 14 recorded blocks</text>
                    </column>
                  </row>
                  <if test="{hasHistory}">
                    <timeline gap="4" label="Focus session history">
                      <for each="historySessions" key="id" as="s">
                        <timeline-item global-key="{s.id}" title="{s.taskTitle}" description="{s.durationLabel}" meta="{s.meta}" variant="{s.tone}" connector="{s.connector}" />
                      </for>
                    </timeline>
                  </if>
                  <else>
                    <column height="150" gap="10" main="center" cross="center">
                      <icon name="clock" foreground="text_muted" />
                      <text text-alignment="center"><span weight="medium">No entries yet</span></text>
                      <text width="380" wrap="true" text-alignment="center" foreground="text_muted">Your first completed block will be recorded here.</text>
                      <button variant="primary" on-press="show_today">Go to Today</button>
                    </column>
                  </else>
                </column>
              </column>
            </row>
          </scroll>
        </else>
      </else>
    </else>
  </column>

  <if test="{mainEndDialogOpen and not isBreak}">
    <column main="center" cross="center">
      <dialog text="Finish this focus block?" width="480" padding="24" on-dismiss="cancel_end_focus">
        <column gap="16">
          <spacer height="16" />
          <text wrap="true" foreground="text_muted">Keep the focused time so far, or discard this unfinished block.</text>
          <row gap="8" main="end">
            <button variant="ghost" autofocus="true" on-press="cancel_end_focus">Continue focusing</button>
            <button variant="destructive" disabled="{saving or hasWriteError}" on-press="confirm_end_focus">Discard block</button>
            <button variant="primary" icon="check" disabled="{saving or hasWriteError}" on-press="finish_focus_now">Record elapsed time</button>
          </row>
        </column>
      </dialog>
    </column>
  </if>

  <if test="{mainEndDialogOpen and isBreak}">
    <column main="center" cross="center">
      <dialog text="Finish this break?" width="480" padding="24" on-dismiss="cancel_end_focus">
        <column gap="16">
          <spacer height="16" />
          <text wrap="true" foreground="text_muted">Keep the rest taken so far, or discard this unfinished break.</text>
          <row gap="8" main="end">
            <button variant="ghost" autofocus="true" on-press="cancel_end_focus">Continue break</button>
            <button variant="destructive" disabled="{saving or hasWriteError}" on-press="confirm_end_focus">Discard break</button>
            <button variant="primary" icon="check" disabled="{saving or hasWriteError}" on-press="finish_focus_now">Record break so far</button>
          </row>
        </column>
      </dialog>
    </column>
  </if>

  <if test="{purgeDialogOpen}">
    <column grow="1" padding="32" main="center" cross="center">
      <dialog text="Delete this task permanently?" width="500" padding="24" on-dismiss="cancel_purge_task">
        <column gap="16">
          <spacer height="16" />
          <text><span weight="bold">{purgeTaskTitle}</span></text>
          <text wrap="true">This removes the task from your archive and cannot be undone.</text>
          <text wrap="true" foreground="text_muted">Recorded focus time stays in the Ledger, but the task name and session association are removed.</text>
          <row gap="8" main="end">
            <button key="{purgeFocusKey}" variant="ghost" autofocus="{purgeAutofocus}" disabled="{saving}" on-press="cancel_purge_task">Cancel</button>
            <button variant="destructive" disabled="{saving or hasWriteError}" on-press="confirm_purge_task">Delete permanently</button>
          </row>
        </column>
      </dialog>
    </column>
  </if>
</stack>
