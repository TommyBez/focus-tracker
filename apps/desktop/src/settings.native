<!--
  Preferences commit immediately through the authoritative SQLite snapshot.
  Each row pairs the three common presets with a stepper, so the defaults are
  no longer limited to the three values the first release could express —
  SQLite has always accepted the full range shown in each row's caption.
-->
<column background="background" grow="1" padding="16" gap="12" label="Focus Tracker settings">
  <!--
    The cards hug their content instead of absorbing the window's spare
    height, so the transient "Saving" row below never resizes them.
  -->
  <row gap="16" cross="stretch">
    <column
      grow="1"
      background="surface_subtle"
      radius="lg"
      padding="16"
      gap="12"
      label="Timer default settings"
    >
      <column gap="4">
        <text><span weight="medium">Timer defaults</span></text>
        <text size="sm" wrap="true" foreground="text_muted">Starting lengths. Today can still adjust a single block without changing these.</text>
      </column>

      <separator />

      <row gap="12" cross="center">
        <column grow="1" gap="4">
          <text><span weight="medium">Focus block</span></text>
          <text size="sm" foreground="text_muted">Default work interval</text>
        </column>
        <row gap="8" cross="center">
          <toggle-group label="Default focus block length" gap="2">
            <toggle-button size="sm" selected="{settingsFocusMinutes == 25}" autofocus="{settingsFocusMinutes == 25}" disabled="{saving or hasWriteError}" on-toggle="set_duration_25">25</toggle-button>
            <toggle-button size="sm" selected="{settingsFocusMinutes == 50}" autofocus="{settingsFocusMinutes == 50}" disabled="{saving or hasWriteError}" on-toggle="set_duration_50">50</toggle-button>
            <toggle-button size="sm" selected="{settingsFocusMinutes == 90}" autofocus="{settingsFocusMinutes == 90}" disabled="{saving or hasWriteError}" on-toggle="set_duration_90">90</toggle-button>
          </toggle-group>
          <row width="132" gap="4" cross="center" main="end">
            <button size="icon" variant="outline" icon="chevron-down" autofocus="{not settingsFocusIsPreset}" label="Shorten the default focus block by 5 minutes" disabled="{saving or hasWriteError}" on-press="default_focus_down"></button>
            <text width="60" text-alignment="center" label="{settingsFocusMinutes ++ ' minute default focus block, 5 to 180 minutes'}"><span mono="true" weight="medium">{settingsFocusMinutes} min</span></text>
            <button size="icon" variant="outline" icon="chevron-up" label="Lengthen the default focus block by 5 minutes" disabled="{saving or hasWriteError}" on-press="default_focus_up"></button>
          </row>
        </row>
      </row>

      <separator />

      <row gap="12" cross="center">
        <column grow="1" gap="4">
          <text><span weight="medium">Short break</span></text>
          <text size="sm" foreground="text_muted">After each focus block</text>
        </column>
        <row gap="8" cross="center">
          <toggle-group label="Short break length" gap="2">
            <toggle-button size="sm" selected="{shortBreakMinutes == 5}" disabled="{saving or hasWriteError}" on-toggle="set_short_break_5">5</toggle-button>
            <toggle-button size="sm" selected="{shortBreakMinutes == 10}" disabled="{saving or hasWriteError}" on-toggle="set_short_break_10">10</toggle-button>
            <toggle-button size="sm" selected="{shortBreakMinutes == 15}" disabled="{saving or hasWriteError}" on-toggle="set_short_break_15">15</toggle-button>
          </toggle-group>
          <row width="132" gap="4" cross="center" main="end">
            <button size="icon" variant="outline" icon="chevron-down" label="Shorten the short break by one minute" disabled="{saving or hasWriteError}" on-press="short_break_down"></button>
            <text width="60" text-alignment="center" label="{shortBreakMinutes ++ ' minute short break, 1 to 30 minutes'}"><span mono="true" weight="medium">{shortBreakMinutes} min</span></text>
            <button size="icon" variant="outline" icon="chevron-up" label="Lengthen the short break by one minute" disabled="{saving or hasWriteError}" on-press="short_break_up"></button>
          </row>
        </row>
      </row>

      <separator />

      <row gap="12" cross="center">
        <column grow="1" gap="4">
          <text><span weight="medium">Long break</span></text>
          <text size="sm" foreground="text_muted">After every fourth block</text>
        </column>
        <row gap="8" cross="center">
          <toggle-group label="Long break length" gap="2">
            <toggle-button size="sm" selected="{longBreakMinutes == 15}" disabled="{saving or hasWriteError}" on-toggle="set_long_break_15">15</toggle-button>
            <toggle-button size="sm" selected="{longBreakMinutes == 20}" disabled="{saving or hasWriteError}" on-toggle="set_long_break_20">20</toggle-button>
            <toggle-button size="sm" selected="{longBreakMinutes == 30}" disabled="{saving or hasWriteError}" on-toggle="set_long_break_30">30</toggle-button>
          </toggle-group>
          <row width="132" gap="4" cross="center" main="end">
            <button size="icon" variant="outline" icon="chevron-down" label="Shorten the long break by 5 minutes" disabled="{saving or hasWriteError}" on-press="long_break_down"></button>
            <text width="60" text-alignment="center" label="{longBreakMinutes ++ ' minute long break, 5 to 60 minutes'}"><span mono="true" weight="medium">{longBreakMinutes} min</span></text>
            <button size="icon" variant="outline" icon="chevron-up" label="Lengthen the long break by 5 minutes" disabled="{saving or hasWriteError}" on-press="long_break_up"></button>
          </row>
        </row>
      </row>
    </column>

    <column
      width="248"
      background="surface_subtle"
      radius="lg"
      padding="16"
      gap="12"
      label="Daily settings"
    >
      <column gap="4">
        <text><span weight="medium">Daily</span></text>
        <text size="sm" foreground="text_muted">Goal and notification settings.</text>
      </column>

      <separator />

      <column gap="8">
        <column gap="4">
          <text><span weight="medium">Focus goal</span></text>
          <text size="sm" foreground="text_muted">Minutes per day</text>
        </column>
        <toggle-group label="Daily focus goal" gap="2">
          <toggle-button size="sm" selected="{dailyGoalMinutes == 60}" disabled="{saving or hasWriteError}" on-toggle="set_daily_goal_60">1 h</toggle-button>
          <toggle-button size="sm" selected="{dailyGoalMinutes == 120}" disabled="{saving or hasWriteError}" on-toggle="set_daily_goal_120">2 h</toggle-button>
          <toggle-button size="sm" selected="{dailyGoalMinutes == 180}" disabled="{saving or hasWriteError}" on-toggle="set_daily_goal_180">3 h</toggle-button>
        </toggle-group>
        <row gap="4" cross="center">
          <button size="icon" variant="outline" icon="chevron-down" label="Lower the daily focus goal by 15 minutes" disabled="{saving or hasWriteError}" on-press="daily_goal_down"></button>
          <text grow="1" text-alignment="center" label="{dailyGoalMinutes ++ ' minute daily focus goal, 15 to 600 minutes'}"><span mono="true" weight="medium">{dailyGoalMinutes} min</span></text>
          <button size="icon" variant="outline" icon="chevron-up" label="Raise the daily focus goal by 15 minutes" disabled="{saving or hasWriteError}" on-press="daily_goal_up"></button>
        </row>
      </column>

      <separator />

      <row gap="12" cross="center">
        <column grow="1" gap="4">
          <text><span weight="medium">Completion sound</span></text>
          <text size="sm" foreground="text_muted">Chime when time ends</text>
        </column>
        <switch
          key="{soundSwitchKey}"
          checked="{soundEnabled}"
          disabled="{saving or hasWriteError}"
          label="Play completion sound"
          on-toggle="toggle_sound"
        />
      </row>
    </column>
  </row>

  <column
    background="surface_subtle"
    radius="lg"
    padding="16"
    gap="12"
    label="Quick Focus global shortcut settings"
  >
    <row gap="16" cross="center">
      <column grow="1" gap="4">
        <text><span weight="medium">Global Quick Focus shortcut</span></text>
        <text size="sm" foreground="text_muted" wrap="true">Open Quick Focus from any app while Focus Tracker is running.</text>
      </column>
      <text size="sm" foreground="text_muted"><span mono="true" weight="medium">{quickShortcutLabel}</span></text>
      <switch
        key="{quickShortcutSwitchKey}"
        checked="{quickShortcutEnabled}"
        disabled="{saving or hasWriteError}"
        label="Enable the global Quick Focus shortcut"
        on-toggle="toggle_quick_shortcut"
      />
    </row>

    <separator />

    <row gap="20" cross="start">
      <column grow="1" gap="6">
        <text size="sm" foreground="text_muted">Modifiers</text>
        <toggle-group label="Global shortcut modifiers, first row" gap="2">
          <toggle-button size="sm" selected="{quickShortcutModifiers == 'command_shift'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_modifiers_command_shift">Cmd + Shift</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutModifiers == 'command_option'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_modifiers_command_option">Cmd + Option</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutModifiers == 'command_control'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_modifiers_command_control">Cmd + Ctrl</toggle-button>
        </toggle-group>
        <toggle-group label="Global shortcut modifiers, second row" gap="2">
          <toggle-button size="sm" selected="{quickShortcutModifiers == 'control_shift'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_modifiers_control_shift">Ctrl + Shift</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutModifiers == 'control_option'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_modifiers_control_option">Ctrl + Option</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutModifiers == 'command_control_shift'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_modifiers_command_control_shift">Cmd + Ctrl + Shift</toggle-button>
        </toggle-group>
      </column>

      <column width="252" gap="6">
        <text size="sm" foreground="text_muted">Key</text>
        <toggle-group label="Global shortcut key" gap="2">
          <toggle-button size="sm" selected="{quickShortcutKey == 'f'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_key_f">F</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutKey == 'q'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_key_q">Q</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutKey == 'k'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_key_k">K</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutKey == 't'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_key_t">T</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutKey == 'p'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_key_p">P</toggle-button>
          <toggle-button size="sm" selected="{quickShortcutKey == 'space'}" disabled="{saving or hasWriteError or not quickShortcutEnabled}" on-toggle="set_quick_shortcut_key_space">Space</toggle-button>
        </toggle-group>
      </column>
    </row>

    <if test="{quickShortcutHasError}">
      <text size="sm" foreground="destructive" wrap="true">{quickShortcutStatusText}</text>
    </if>
    <else>
      <text size="sm" foreground="text_muted" wrap="true">{quickShortcutStatusText}</text>
    </else>
  </column>

  <if test="{saving or hasWriteError}">
    <if test="{saving}">
      <row height="32" gap="8" cross="center" label="Saving settings">
        <spinner />
        <text size="sm" foreground="text_muted">Saving</text>
      </row>
    </if>
    <else>
      <row height="32" gap="8" cross="center" label="Settings were not saved">
        <text size="sm" foreground="destructive"><span weight="medium">Unable to save</span></text>
        <text size="sm" foreground="text_muted" grow="1" overflow="ellipsis">{writeErrorText}</text>
        <button size="sm" variant="ghost" on-press="discard_failed_change">Discard</button>
        <button size="sm" variant="outline" icon="refresh-cw" on-press="retry_save">Retry</button>
      </row>
    </else>
  </if>
</column>
