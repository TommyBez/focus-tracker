{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "package:app": {
      "cache": false
    },
    "package:dmg": {
      "dependsOn": ["package:app"],
      "cache": false
    },
    "verify:dmg": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
